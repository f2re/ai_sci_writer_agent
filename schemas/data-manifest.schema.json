{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["datasets"],
  "properties": {
    "datasets": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "provenance", "files"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "kind": {"enum": ["empirical", "synthetic", "simulation"]},
      "provenance": {"type": "string", "minLength": 10},
      "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }}}
    }}}
  }
}

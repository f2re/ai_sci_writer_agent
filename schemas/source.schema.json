{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "authors",
    "year",
    "url",
    "type",
    "access",
    "metadata_verified",
    "status",
    "tradition",
    "is_foundational"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^S[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1000,
      "maximum": 2200
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "isbn": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "article",
        "book",
        "chapter",
        "thesis",
        "standard",
        "dataset",
        "software",
        "preprint",
        "other"
      ]
    },
    "access": {
      "enum": [
        "full_text",
        "selected_pages",
        "abstract_only",
        "metadata_only",
        "unavailable"
      ]
    },
    "metadata_verified": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "candidate",
        "included",
        "excluded"
      ]
    },
    "tradition": {
      "enum": [
        "russian",
        "international",
        "other",
        "undetermined"
      ]
    },
    "is_foundational": {
      "type": "boolean"
    },
    "verification_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "verified_at": {
      "type": "string",
      "minLength": 10
    },
    "read_locator": {
      "type": "string"
    },
    "local_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "journal": {
      "type": "string",
      "minLength": 1
    },
    "volume": {
      "type": "string",
      "minLength": 1
    },
    "issue": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "edn": {
      "type": "string",
      "minLength": 1
    },
    "booktitle": {
      "type": "string",
      "minLength": 1
    },
    "article_number": {
      "type": "string",
      "minLength": 1
    },
    "issn": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "openalex_id": {
      "type": "string",
      "minLength": 1
    },
    "abstract": {
      "type": "string",
      "minLength": 1
    },
    "pdf_url": {
      "type": "string",
      "minLength": 1
    },
    "accessed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "editors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
